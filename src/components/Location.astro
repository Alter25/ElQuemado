---
import { WHATSAPP_URL, DIRECCION, MAPS_EMBED, MAPS_URL } from '../config';
---
<section id="ubicacion" class="py-24 px-8 max-w-[1200px] mx-auto">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(320px,1fr))] gap-12 items-center">
    <div>
      <span class="uppercase tracking-[1.5px] text-brand-orange font-extrabold text-sm">
        Visítanos
      </span>
      <h2 class="font-fredoka font-bold text-brand-brown text-[clamp(26px,4vw,36px)] mt-3 mb-4">
        Te esperamos en Gómez Palacio
      </h2>
      <p class="text-brand-brown font-bold text-[17px] leading-relaxed mb-7">
        {DIRECCION}
      </p>
      <div class="flex gap-4 flex-wrap">
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="px-7 py-3.5 rounded-full bg-brand-green text-white font-extrabold text-sm hover:scale-105 transition-transform no-underline"
        >
          Pedir por WhatsApp
        </a>
        <a
          href={MAPS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="px-7 py-3.5 rounded-full border-2 border-brand-green text-brand-green font-extrabold text-sm hover:bg-brand-green/10 transition-colors no-underline"
        >
          Cómo llegar
        </a>
      </div>
    </div>

    <iframe
      src={MAPS_EMBED}
      title="Ubicación de Elotes y Nachos El Quemado en Gómez Palacio"
      class="w-full h-[340px] border-0 rounded-2xl shadow-[0_10px_30px_rgba(43,26,16,0.12)]"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>
</section>
