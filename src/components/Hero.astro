---
import { WHATSAPP_URL, FACEBOOK_URL } from '../config';
---
<section
  class="relative min-h-[92vh] flex items-end bg-cover bg-center"
  style="background-image: url('/uploads/muestra3.jpg')"
>
  <div class="absolute inset-0 bg-gradient-to-b from-brand-brown/20 via-brand-brown/55 to-black/92"></div>

  <div class="relative z-10 max-w-2xl px-8 pb-24 text-white animate-fade-up">
    <span class="uppercase tracking-[1.5px] text-brand-yellow font-extrabold text-sm">
      Antojitos mexicanos · Gómez Palacio, Dgo.
    </span>
    <h1 class="font-fredoka font-bold text-[clamp(36px,6vw,64px)] leading-[1.05] mt-4 mb-0">
      El sabor que te hace volver por más
    </h1>
    <p class="text-[clamp(16px,2vw,20px)] leading-relaxed max-w-xl mt-4 opacity-95">
      Elotes recién preparados, dorilocos cargados de queso, ramen coreano picante
      y dulces enchilados hechos al momento. Todo con la sazón de El Quemado.
    </p>
    <div class="flex gap-4 flex-wrap mt-8">
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="px-7 py-4 rounded-full bg-brand-yellow text-brand-brown font-extrabold text-base shadow-xl hover:scale-105 transition-transform no-underline"
      >
        Pedir por WhatsApp
      </a>
      <a
        href="#menu"
        class="px-7 py-4 rounded-full border-2 border-white/70 text-white font-bold text-base hover:bg-white/10 transition-colors no-underline"
      >
        Ver el menú
      </a>
    </div>
  </div>
</section>
